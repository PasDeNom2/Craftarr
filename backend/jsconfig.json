{
  "compilerOptions": {
    "checkJs": false,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "module": "commonjs",
    "target": "es2022",
    "moduleResolution": "node",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/services/validate.js",
    "src/services/serverLock.js",
    "src/services/zipStream.js",
    "src/services/metrics.js",
    "src/routes/servers/files.js",
    "src/routes/servers/common.js",
    "src/config/secrets.js",
    "src/config/encryption.js",
    "src/middleware/errorHandler.js"
  ]
}
