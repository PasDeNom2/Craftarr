# ============================================================
# Craftarr — Configuration
# Copiez ce fichier en .env et ajustez les valeurs
# ============================================================

# Les secrets (JWT, clé de chiffrement) sont générés automatiquement au premier
# démarrage dans data/secrets.json — ne les définissez ici que pour les imposer.
# Le compte admin se crée dans l'interface (jeton affiché dans les logs du backend).

# --- Port de l'interface web ---
UI_PORT=1024

# --- APIs Modpacks (optionnel, configurable aussi dans l'UI) ---
# CurseForge : https://console.curseforge.com/
CURSEFORGE_API_KEY=

# Modrinth n'exige pas de clé mais permet un rate limit plus élevé
MODRINTH_API_KEY=

# --- Auto-update ---
UPDATE_CHECK_INTERVAL_HOURS=6

# --- Backups automatiques des serveurs en marche (0 = désactivé) ---
BACKUP_INTERVAL_HOURS=6
# Nombre de backups automatiques conservés par serveur (les manuels ne sont jamais supprimés)
BACKUP_KEEP=8

# --- Image Minecraft (itzg/minecraft-server) ---
# Par défaut Craftarr suit les tags javaXX (mis à jour par l'auteur de l'image). Pour figer une
# version testée (recommandé en production), indiquez-la ici : les tags deviennent <version>-javaXX.
# Liste : https://hub.docker.com/r/itzg/minecraft-server/tags  (ex. 2025.6.2)
MINECRAFT_IMAGE_VERSION=

# --- Notifications (crash, mise à jour, backup en échec) ---
# Webhook Discord ou compatible Slack ; aussi réglable dans Paramètres → Notifications
NOTIFY_WEBHOOK_URL=
